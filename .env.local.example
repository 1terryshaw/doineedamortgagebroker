# Site scope — REQUIRED, and unlike the rest of this file it needs a real value.
# src/lib/country.ts throws at import if it is unset or not exactly "CA" or "US", so a
# fresh `npm run build` fails without it ("NEXT_PUBLIC_COUNTRY is not set").
#   "US" -> doineedamortgagebroker.com   |   "CA" -> findmymortgagebroker.ca
# Both domains are this same repo deployed twice; Vercel sets this per-project in prod.
NEXT_PUBLIC_COUNTRY=US

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API
GOOGLE_PLACES_API_KEY=

# Anthropic (for enrichment)
ANTHROPIC_API_KEY=

# Gmail SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Admin
ADMIN_EMAIL=
